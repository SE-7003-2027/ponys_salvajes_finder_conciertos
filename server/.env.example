# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=concert_finder

# Application Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback

# Ticketmaster: required for GET /api/artists/:id/music (same key as the client's VITE_TICKETMASTER_API_KEY)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Optional: identify the app to MusicBrainz (they ask for a contact URL or email)
MUSICBRAINZ_USER_AGENT=ConcertFinder/1.0 (https://github.com/SE-7003-2027/ponys_salvajes_finder_conciertos)
