DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_NAME=concert_finder
JWT_SECRET=your_super_secret_key_here
PORT=3000

# Required for GET /api/artists/:id/music (same key as the client's VITE_TICKETMASTER_API_KEY)
TICKETMASTER_API_KEY=

# Optional: Spotify app credentials (Client Credentials flow).
# Without them, the discography comes from MusicBrainz and the Spotify
# link/player still work when Ticketmaster knows the artist's Spotify id.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: identify the app to MusicBrainz (they ask for a contact URL or email)
MUSICBRAINZ_USER_AGENT=ConcertFinder/1.0 (https://github.com/SE-7003-2027/ponys_salvajes_finder_conciertos)
